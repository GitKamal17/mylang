{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}):",
      "    return ${0:0}"
    ]
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}:",
      "    ${2:print \"yes\"}",
      "else:",
      "    ${0:print \"no\"}"
    ]
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "    ${0}"
    ]
  },
  "Game window": {
    "prefix": "window",
    "body": [
      "window \"${1:My Game}\", ${2:800}, ${3:600}",
      "",
      "circle ${4:400}, ${5:300}, ${6:30}, \"${7:red}\""
    ]
  },
  "Print": {
    "prefix": "print",
    "body": "print ${0:\"Hello, Vibes!\"}"
  }
}
